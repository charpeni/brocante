{
  "name": "@brocante/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:github": "bash scripts/setup-github-app.sh",
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "deploy": "pnpm build && wrangler deploy",
    "check": "astro check",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@brocante/core": "workspace:*",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "astro": "^7.3.5",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
