{
  "name": "brocante",
  "version": "1.1.0",
  "description": "Brocante turns your GitHub repository’s open pull requests into a 3D flea market. Browse the shops, spot aging PRs, and find your next review.",
  "keywords": [
    "cli",
    "code-review",
    "github",
    "pull-requests"
  ],
  "homepage": "https://github.com/charpeni/brocante/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/charpeni/brocante/issues"
  },
  "license": "MIT",
  "author": "Nicolas Charpentier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charpeni/brocante.git",
    "directory": "packages/cli"
  },
  "bin": {
    "brocante": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "verify:tag": "node scripts/check-tag.mjs"
  },
  "devDependencies": {
    "@brocante/core": "workspace:*",
    "@brocante/snapshot": "workspace:*",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
