{
  "name": "bb-plugin-brocante",
  "version": "1.0.0",
  "private": true,
  "description": "Brocante turns your GitHub repository’s open pull requests into a 3D flea market. Browse the shops, spot aging PRs, and find your next review.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && bb plugin build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "verify:bundle": "node scripts/build.mjs --check",
    "verify:tag": "node scripts/check-tag.mjs"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bb-app": "0.45.0",
    "cron-parser": "^5.10.1",
    "esbuild": "^0.28.1",
    "jsdom": "29.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15 <0.7"
  },
  "bb": {
    "name": "Brocante",
    "description": "Brocante turns your GitHub repository’s open pull requests into a 3D flea market. Browse the shops, spot aging PRs, and find your next review.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.js",
    "app": "./src/app.tsx",
    "skills": [
      "skills"
    ]
  }
}
